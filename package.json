{
  "name": "synccode",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @synccode/sync --filter @synccode/web dev",
    "dev:sync": "pnpm --filter @synccode/sync dev",
    "dev:web": "pnpm --filter @synccode/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @synccode/web test:e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @synccode/db generate",
    "db:migrate": "pnpm --filter @synccode/db migrate",
    "seed": "tsx scripts/seed-rooms.ts",
    "compact": "tsx scripts/compact-snapshots.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@synccode/shared": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "yjs": "^13.6.33"
  }
}
